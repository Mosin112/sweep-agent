# Claude. Leave the key empty to run the deterministic baseline instead of the agent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Where balances come from. Empty = read data/treasury.json directly.
# Set to the dashboard URL (npm run dashboard) or your own internal treasury API.
DASHBOARD_URL=

# Policy file the agent is bound by.
POLICY_PATH=policies/treasury-policy.yaml

# Slack (npm run slack). Create the app from slack/manifest.yaml.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
# Optional: run a sweep automatically every N minutes and post it to SLACK_CHANNEL_ID.
SWEEP_INTERVAL_MINUTES=

# Dashboard port
DASHBOARD_PORT=4100
